<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jtools.framework</groupId>
    <artifactId>jtools-parent</artifactId>
    <version>1.2.0</version>
    <relativePath>conventions/parent/pom.xml</relativePath>
  </parent>

  <artifactId>jtools-framework</artifactId>
  <packaging>pom</packaging>

  <name>JToolsFramework</name>
  <description>A framework for local web applications in Java — a server holding the business, a page in the browser as its view, the program stopping once its last page is closed, self-contained distributions — as libraries, build conventions, a development environment and a project template.</description>

  <!-- The parts, a folder each, named for what a developer does with it (doc/design/DESIGN-1.2.md):
         conventions/  what a project's build inherits: jtools-parent, jtools-bom (the versions alone), jtools-dist
         libraries/    what a program's code calls: jtools-support, -server, -app, -desktop, -web
         devkit/       what a project carries — its scripts, its externals — and the starter: jtools-devkit
         examples/     the smallest programs, built and tested with the rest, never published
       One version for all, said in every pom and as jtools.version in conventions/parent/pom.xml:
       scripts/check-versions.sh checks they agree. -->
  <modules>
    <module>conventions/bom</module>
    <module>conventions/parent</module>
    <module>libraries/support</module>
    <module>libraries/server</module>
    <module>libraries/app</module>
    <module>libraries/desktop</module>
    <module>conventions/dist</module>
    <module>libraries/web</module>
    <module>devkit</module>
    <module>examples/hello</module>
    <module>examples/todo</module>
    <module>examples/greeter</module>
  </modules>
</project>
