<?xml version="1.0" encoding="UTF-8"?>
<!-- child.*.inherit.append.path: every module of the framework lives in the one repository, so its url and scm are
     the repository's, not the repository's with the module's artifactId appended (Maven's default) -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
  <modelVersion>4.0.0</modelVersion>

  <!-- The parent of every project on JToolsFramework, and of the framework's own modules: the conventions of the build,
       said once. A project's root pom names it as <parent>, sets the jtools.app.* properties below, and gets:
         - Java 25, UTF-8, JUnit 5, the plugins' versions, the tests run from the root of the repository;
         - in a module holding an angular.json: the page built by npm (install, build, test), its build under
           static/ in the module's jar, and @jtools/web unpacked into target/jtools-web (profile jtools-frontend);
         - in the module setting jtools.app.skip to false: the program's one jar, embedding every module
           (jtools-embed), and with -Pdist the Linux, macOS and Windows distributions, each with a runtime jlink trims, the
           launchers and the .ini (profile dist; the descriptors come from jtools-dist).
       doc/CONVENTIONS.md in JToolsFramework says it in full. -->
  <groupId>org.jtools.framework</groupId>
  <artifactId>jtools-parent</artifactId>
  <version>1.5.1</version>
  <packaging>pom</packaging>

  <name>JToolsFramework parent</name>
  <description>The build conventions of a project on JToolsFramework: a Java server, an Angular page as its view, and self-contained distributions.</description>

  <!-- What Maven Central requires of every pom it publishes, and shows.
       A project inheriting jtools-parent inherits these too, as with any parent; one publishing its own artifacts
       declares its own (doc/CONVENTIONS.md, "The licence"). -->
  <url>https://github.com/j4ckk0/JToolsFramework</url>
  <inceptionYear>2026</inceptionYear>
  <organization>
    <name>jtools.org</name>
    <url>https://github.com/j4ckk0</url>
  </organization>
  <licenses>
    <license>
      <name>Apache License Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>j4ckk0</id>
      <name>Jacques HENRY</name>
      <email>j4ckk057@gmail.com</email>
      <organization>jtools.org</organization>
      <organizationUrl>https://github.com/j4ckk0</organizationUrl>
    </developer>
  </developers>
  <scm child.scm.connection.inherit.append.path="false"
       child.scm.developerConnection.inherit.append.path="false"
       child.scm.url.inherit.append.path="false">
    <connection>scm:git:https://github.com/j4ckk0/JToolsFramework.git</connection>
    <developerConnection>scm:git:git@github.com:j4ckk0/JToolsFramework.git</developerConnection>
    <url>https://github.com/j4ckk0/JToolsFramework</url>
    <tag>HEAD</tag>
  </scm>
  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/j4ckk0/JToolsFramework/issues</url>
  </issueManagement>

  <properties>
    <!-- the framework's version, for the projects' dependencies on its modules: always this pom's own <version> -->
    <jtools.version>1.5.1</jtools.version>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.12.2</junit.version>

    <!-- The program a project builds, set in its root pom:
           jtools.app.id               its jar, .ini, launchers and releases: <id>.jar, <id>.ini, <id>-<version>-linux.tar.gz
           jtools.app.name             its name, as people read it, and its Windows launcher: <name>.exe
           jtools.app.mainClass        the class starting it (most often a call to org.jtools.framework.app.WebApp)
           jtools.app.port             the port its .ini says: one of its own, so that it runs beside other programs
           jtools.app.windowsVersion   the version in the four parts an .exe wants: 1.2 is 1.2.0.0
           jtools.app.description      what Windows says of <name>.exe (its file description): its name unless said -->
    <jtools.app.id>app</jtools.app.id>
    <jtools.app.name>App</jtools.app.name>
    <jtools.app.mainClass></jtools.app.mainClass>
    <jtools.app.port>0</jtools.app.port>
    <jtools.app.windowsVersion>0.0.0.0</jtools.app.windowsVersion>
    <jtools.app.description>${jtools.app.name}</jtools.app.description>
    <jtools.app.copyright>j4ckk0</jtools.app.copyright>

    <!-- what a module opts out of — or, for the program, into: the module that sets jtools.app.skip to false
         builds the program's one jar and, with -Pdist, the distributions; in a page's module, jtools.page.skip leaves
         the built page out of its jar and jtools.weblib.skip does not unpack @jtools/web, the framework's TypeScript, there -->
    <jtools.app.skip>true</jtools.app.skip>
    <jtools.page.skip>false</jtools.page.skip>
    <jtools.weblib.skip>false</jtools.weblib.skip>
    <!-- the way npm installs the page's dependencies: "install", or "ci" for exactly package-lock.json (scripts/linux/ci.sh) -->
    <npm.install>install</npm.install>
    <!-- profile publish: a jar module holding no Java sets it to false (and maven.javadoc.skip to true) to publish a
         javadoc jar of one README instead, the javadoc Maven Central requires of every jar -->
    <jtools.javadoc.placeholder.skip>true</jtools.javadoc.placeholder.skip>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- the framework's versions: jtools-bom's, which a build not inheriting this pom imports itself -->
      <dependency>
        <groupId>org.jtools.framework</groupId>
        <artifactId>jtools-bom</artifactId>
        <version>${jtools.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
          <configuration>
            <!-- the tests read files relative to the root of the repository, whichever module they belong to -->
            <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.3.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.1</version>
          <configuration>
            <archive>
              <manifest>
                <!-- Implementation-Title and -Version: what a program says of itself (Installation.version) -->
                <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
              </manifest>
            </archive>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.1.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>3.1.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.4.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>3.8.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-antrun-plugin</artifactId>
          <version>3.1.0</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>com.akathist.maven.plugins.launch4j</groupId>
          <artifactId>launch4j-maven-plugin</artifactId>
          <version>2.7.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>3.6.0</version>
        </plugin>
        <!-- the publish profile's plugins: here so that a module keeping itself off Maven Central names the portal's
             plugin with no version of its own (<skipPublishing>true</skipPublishing>: a program's own modules, an example) -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>3.3.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>3.6.3</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-gpg-plugin</artifactId>
          <version>3.2.4</version>
        </plugin>
        <plugin>
          <groupId>org.sonatype.central</groupId>
          <artifactId>central-publishing-maven-plugin</artifactId>
          <!-- at least this one: older versions fail on a field of the portal's status answer (PUBLISHING.md) -->
          <version>0.11.0</version>
        </plugin>
        <!-- The Apache 2.0 header at the top of every Java source, main and test: a module gets it by naming this
             plugin — the framework's libraries do, a project inheriting this parent does not unless it is published
             under that licence too. -->
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>license-maven-plugin</artifactId>
          <version>2.4.0</version>
          <configuration>
            <verbose>false</verbose>
            <licenseName>apache_v2</licenseName>
            <organizationName>jtools.org</organizationName>
            <inceptionYear>2026</inceptionYear>
            <canUpdateCopyright>true</canUpdateCopyright>
          </configuration>
          <executions>
            <execution>
              <id>add-license-headers</id>
              <phase>process-sources</phase>
              <goals>
                <goal>update-file-header</goal>
              </goals>
              <configuration>
                <includes>
                  <include>**/*.java</include>
                </includes>
                <roots>
                  <root>src/main/java</root>
                  <root>src/test</root>
                </roots>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- The program's jar, in the module that sets jtools.app.skip to false: one jar, java -jar <id>.jar,
           embedding every module and library it depends on, the page included, with the program's main class and
           version. Declared here rather than in that module so that it runs before the dist profile's distributions in the
           same phase: the build's own plugins run before its profiles', and the distributions carry this jar. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <id>jtools-embed</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <skip>${jtools.app.skip}</skip>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <!-- a modular library's descriptor stays out: the program's jar is a plain classpath one -->
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>${jtools.app.mainClass}</mainClass>
                  <manifestEntries>
                    <Implementation-Title>${jtools.app.name}</Implementation-Title>
                    <Implementation-Version>${project.version}</Implementation-Version>
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      The page: in a module holding an angular.json, npm builds it — the npm of PATH, external/node's when the
      scripts run Maven — into target/angular (angular.json: outputPath), which joins the module's jar as static/,
      the folder WebServer serves. @jtools/web, the framework's TypeScript, is unpacked into target/jtools-web
      first, where tsconfig.json's "paths" finds it.
    -->
    <profile>
      <id>jtools-frontend</id>
      <activation>
        <file>
          <exists>${basedir}/angular.json</exists>
        </file>
      </activation>
      <properties>
        <skipTests>false</skipTests>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <id>jtools-web</id>
                <phase>initialize</phase>
                <goals>
                  <goal>unpack</goal>
                </goals>
                <configuration>
                  <skip>${jtools.weblib.skip}</skip>
                  <artifactItems>
                    <artifactItem>
                      <groupId>org.jtools.framework</groupId>
                      <artifactId>jtools-web</artifactId>
                      <version>${jtools.version}</version>
                      <includes>jtools-web/**</includes>
                    </artifactItem>
                  </artifactItems>
                  <outputDirectory>${project.build.directory}</outputDirectory>
                  <overWriteReleases>true</overWriteReleases>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <configuration>
              <executable>npm</executable>
            </configuration>
            <executions>
              <execution>
                <id>npm-install</id>
                <phase>generate-resources</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <arguments>
                    <argument>${npm.install}</argument>
                    <argument>--no-audit</argument>
                    <argument>--no-fund</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>ng-build</id>
                <phase>generate-resources</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <arguments>
                    <argument>run</argument>
                    <argument>build</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>ng-test</id>
                <phase>test</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <skip>${skipTests}</skip>
                  <arguments>
                    <argument>test</argument>
                    <argument>--</argument>
                    <argument>--watch=false</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <executions>
              <execution>
                <id>jtools-page</id>
                <phase>process-resources</phase>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <configuration>
                  <skip>${jtools.page.skip}</skip>
                  <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                  <resources>
                    <resource>
                      <directory>${project.build.directory}/angular/browser</directory>
                    </resource>
                  </resources>
                </configuration>
              </execution>
              <execution>
                <!-- the licences of the libraries the page bundles, which the Angular build writes -->
                <id>jtools-page-licences</id>
                <phase>process-resources</phase>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <configuration>
                  <skip>${jtools.page.skip}</skip>
                  <outputDirectory>${project.build.outputDirectory}/static/licences</outputDirectory>
                  <resources>
                    <resource>
                      <directory>${project.build.directory}/angular</directory>
                      <includes>
                        <include>3rdpartylicenses.txt</include>
                      </includes>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      mvn package -Pdist
      The self-contained distributions, built by the module that sets jtools.app.skip to false (every other module
      skips them), into releases/ at the root of the repository (not tracked, kept by mvn clean):
        releases/<id>-<version>-linux.tar.gz   <id>.sh, <id>.jar, <id>.ini, README.md, LICENSE, NOTICE, jre/
        releases/<id>-<version>-macos.tar.gz   the same, Apple silicon
        releases/<id>-<version>-windows.zip    <name>.exe (no console), <id>.bat (console), the same, jre\
      plus whatever the module keeps in src/dist/files/. Each jre/ is a runtime jlink trims to the modules the program
      needs (jdeps on its jar, and jtools.dist.modules.extra), linked from that platform's jmods in external/
      (jmods-linux.tar.gz, jmods-windows.zip, jmods-macos.tar.gz: scripts/linux/setup.sh); a platform whose jmods are not
      there is not built. jtools-dist's build.xml does it, once the program's jar is made.
    -->
    <profile>
      <id>dist</id>
      <properties>
        <jtools.jdk.archives>${maven.multiModuleProjectDirectory}/external</jtools.jdk.archives>
        <jtools.dist.files>${project.build.directory}/jtools-dist</jtools.dist.files>
        <release.dir>${maven.multiModuleProjectDirectory}/releases</release.dir>
        <!-- what jdeps cannot see in the jar: the charsets of files in any encoding, the elliptic curves TLS needs -->
        <jtools.dist.modules.extra>jdk.charsets,jdk.crypto.ec</jtools.dist.modules.extra>
        <!-- what else of the repository the archives carry under the same path, as Ant patterns: samples/** -->
        <jtools.dist.include>jtools-dist-includes-nothing</jtools.dist.include>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <id>jtools-dist</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>unpack</goal>
                </goals>
                <configuration>
                  <skip>${jtools.app.skip}</skip>
                  <artifactItems>
                    <artifactItem>
                      <groupId>org.jtools.framework</groupId>
                      <artifactId>jtools-dist</artifactId>
                      <version>${jtools.version}</version>
                      <includes>jtools-dist/**</includes>
                    </artifactItem>
                  </artifactItems>
                  <outputDirectory>${project.build.directory}</outputDirectory>
                  <overWriteReleases>true</overWriteReleases>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!-- <name>.exe: a Windows launcher without a console (GUI subsystem) that runs the bundled jre\ with
                 <id>.jar; built from any OS. <id>.bat keeps the console. -->
            <groupId>com.akathist.maven.plugins.launch4j</groupId>
            <artifactId>launch4j-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>jtools-windows-launcher</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>launch4j</goal>
                </goals>
                <configuration>
                  <skip>${jtools.app.skip}</skip>
                  <headerType>gui</headerType>
                  <outfile>${project.build.directory}/${jtools.app.name}.exe</outfile>
                  <dontWrapJar>true</dontWrapJar>
                  <jar>${jtools.app.id}.jar</jar>
                  <chdir>.</chdir>
                  <errTitle>${jtools.app.name}</errTitle>
                  <jre>
                    <path>jre</path>
                    <requiresJdk>false</requiresJdk>
                    <requires64Bit>true</requires64Bit>
                    <minVersion>${maven.compiler.release}</minVersion>
                  </jre>
                  <versionInfo>
                    <fileVersion>${jtools.app.windowsVersion}</fileVersion>
                    <txtFileVersion>${project.version}</txtFileVersion>
                    <fileDescription>${jtools.app.description}</fileDescription>
                    <copyright>${jtools.app.copyright}</copyright>
                    <productVersion>${jtools.app.windowsVersion}</productVersion>
                    <txtProductVersion>${project.version}</txtProductVersion>
                    <productName>${jtools.app.name}</productName>
                    <internalName>${jtools.app.id}</internalName>
                    <originalFilename>${jtools.app.name}.exe</originalFilename>
                  </versionInfo>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!-- in the package phase after the program's jar (jtools-embed, declared before this profile's plugins) -->
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
              <execution>
                <id>jtools-distributions</id>
                <phase>package</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <skip>${jtools.app.skip}</skip>
                  <target>
                    <ant antfile="${jtools.dist.files}/build.xml" target="distributions" inheritAll="false">
                      <property name="jdk.archives" value="${jtools.jdk.archives}"/>
                      <property name="target" value="${project.build.directory}"/>
                      <property name="launchers" value="${jtools.dist.files}/launcher"/>
                      <property name="files" value="${project.basedir}/src/dist/files"/>
                      <property name="root" value="${maven.multiModuleProjectDirectory}"/>
                      <property name="release.dir" value="${release.dir}"/>
                      <property name="jar" value="${project.build.directory}/${project.build.finalName}.jar"/>
                      <property name="exe" value="${project.build.directory}/${jtools.app.name}.exe"/>
                      <property name="version" value="${project.version}"/>
                      <property name="java.release" value="${maven.compiler.release}"/>
                      <property name="modules.extra" value="${jtools.dist.modules.extra}"/>
                      <property name="include" value="${jtools.dist.include}"/>
                      <property name="jtools.app.id" value="${jtools.app.id}"/>
                      <property name="jtools.app.name" value="${jtools.app.name}"/>
                      <property name="jtools.app.port" value="${jtools.app.port}"/>
                    </ant>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      mvn -Ppublish clean deploy
      What Maven Central gets — each jar with its sources and its javadoc, every file signed — in one bundle uploaded to
      the Central Portal, published by hand once its checks pass (autoPublish off: a mistake costs nothing). Here for
      every project inheriting jtools-parent: the framework's own modules use it, and a project publishing its own can. PUBLISHING.md says what it takes, once and per version;
      mvn -Ppublish verify -Dgpg.skip builds the same without signing nor uploading.
      No flatten-maven-plugin: the framework's poms write their versions out; a project with a ${revision} adds it.
    -->
    <profile>
      <id>publish</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <configuration>
              <!-- the comments say what each part is for; not every parameter has its @param -->
              <doclint>all,-missing</doclint>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <!-- A jar holding no Java (jtools-dist, jtools-web) has no javadoc to make, and Maven Central refuses a jar
               without one: its javadoc jar is a README saying where its documentation is. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
              <execution>
                <id>jtools-javadoc-placeholder</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <skip>${jtools.javadoc.placeholder.skip}</skip>
                  <target>
                    <echo file="${project.build.directory}/jtools-javadoc/README.txt">${project.name} ${project.version}

${project.description}

This module holds no Java, so no javadoc: this jar is the one Maven Central requires
beside every jar. The documentation is in the module's own files (its -sources jar) and
in the framework's doc/CONVENTIONS.md: ${project.url}
</echo>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-jar-plugin</artifactId>
            <executions>
              <execution>
                <id>jtools-javadoc-placeholder</id>
                <phase>package</phase>
                <goals>
                  <goal>jar</goal>
                </goals>
                <configuration>
                  <classifier>javadoc</classifier>
                  <classesDirectory>${project.build.directory}/jtools-javadoc</classesDirectory>
                  <!-- nothing written there, nothing made: the modules with Java have their real javadoc -->
                  <skipIfEmpty>true</skipIfEmpty>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!-- signs each file with the GPG key of the one publishing (-Dgpg.keyname= if several) -->
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!-- uploads to the Central Portal, its token in ~/.m2/settings.xml under the server "central"; published
                 by hand from https://central.sonatype.com once its checks pass -->
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
              <!-- the framework's aggregator: nothing depends on it, it only lists the modules to build -->
              <excludeArtifacts>
                <excludeArtifact>jtools-framework</excludeArtifact>
              </excludeArtifacts>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
