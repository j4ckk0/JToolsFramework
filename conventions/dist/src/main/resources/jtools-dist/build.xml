<?xml version="1.0" encoding="UTF-8"?>
<!--
  The distributions of a program, run by jtools-parent's dist profile once its jar is made (mvn package -Pdist):

    modules        the modules the program needs: what jdeps finds in its jar, and jtools.dist.modules.extra
                   besides (what no class names: the charsets, the elliptic curves of TLS)
    runtimes       for each platform whose jmods are in jdk.archives, a runtime trimmed to those modules, linked from
                   its jmods archive (jmods-<os>.*, or Temurin's *jmods*<os>*: a JDK from 24 on carries none), else
                   from its JDK archive's jmods/ (a JDK up to 23). jlink is the one of this machine's JDK archive, so
                   that it matches the jmods' version whatever JDK runs the build; else the running JDK's
    distributions  <id>-<version>-linux.tar.gz and -macos.tar.gz (<id>.sh), -windows.zip (<name>.exe without a
                   console, <id>.bat with one): the jar, the launchers, <id>.ini, the README, LICENSE and NOTICE when
                   the project has them, what jtools.dist.include names of the repository (samples/**) under the
                   same path, the module's src/dist/files/, and the runtime as jre/

  A platform without its archive is not built; jtools-dist's launchers carry ${jtools.app.*} that the copy fills in.
-->
<project name="jtools-dist" default="distributions">

  <property name="work" location="${target}/jtools-dist-work"/>
  <property name="runtime" location="${target}/runtime"/>
  <property name="jmods" location="${target}/jmods"/>
  <property name="dist.name" value="${jtools.app.id}-${version}"/>
  <property name="exec.suffix" value=""/>
  <!-- what else of the repository the archives carry, as Ant patterns from its root; by default, nothing -->
  <property name="include" value="jtools-dist-includes-nothing"/>
  <patternset id="jdk.linux"><include name="jdk-linux.tar.gz"/><include name="*jdk*linux*.tar.gz"/></patternset>
  <patternset id="jdk.windows"><include name="jdk-windows.zip"/><include name="*jdk*windows*.zip"/></patternset>
  <patternset id="jdk.macos"><include name="jdk-macos.tar.gz"/><include name="*jdk*mac*.tar.gz"/></patternset>
  <patternset id="jmods.linux"><include name="jmods-linux.tar.gz"/><include name="*jmods*linux*.tar.gz"/></patternset>
  <patternset id="jmods.windows"><include name="jmods-windows.zip"/><include name="*jmods*windows*.zip"/></patternset>
  <patternset id="jmods.macos"><include name="jmods-macos.tar.gz"/><include name="*jmods*mac*.tar.gz"/></patternset>
  <condition property="exec.suffix" value=".exe"><os family="windows"/></condition>
  <condition property="host" value="windows"><os family="windows"/></condition>
  <condition property="host" value="macos"><os family="mac"/></condition>
  <property name="host" value="linux"/>

  <target name="detect">
    <condition property="jdk.linux"><resourcecount when="greater" count="0"><fileset dir="${jdk.archives}" erroronmissingdir="false"><patternset refid="jdk.linux"/></fileset></resourcecount></condition>
    <condition property="jdk.windows"><resourcecount when="greater" count="0"><fileset dir="${jdk.archives}" erroronmissingdir="false"><patternset refid="jdk.windows"/></fileset></resourcecount></condition>
    <condition property="jdk.macos"><resourcecount when="greater" count="0"><fileset dir="${jdk.archives}" erroronmissingdir="false"><patternset refid="jdk.macos"/></fileset></resourcecount></condition>
    <condition property="jmods.linux"><resourcecount when="greater" count="0"><fileset dir="${jdk.archives}" erroronmissingdir="false"><patternset refid="jmods.linux"/></fileset></resourcecount></condition>
    <condition property="jmods.windows"><resourcecount when="greater" count="0"><fileset dir="${jdk.archives}" erroronmissingdir="false"><patternset refid="jmods.windows"/></fileset></resourcecount></condition>
    <condition property="jmods.macos"><resourcecount when="greater" count="0"><fileset dir="${jdk.archives}" erroronmissingdir="false"><patternset refid="jmods.macos"/></fileset></resourcecount></condition>
    <!-- a platform is built when its jmods are there, apart or in its JDK archive -->
    <condition property="platform.linux"><or><isset property="jmods.linux"/><isset property="jdk.linux"/></or></condition>
    <condition property="platform.windows"><or><isset property="jmods.windows"/><isset property="jdk.windows"/></or></condition>
    <condition property="platform.macos"><or><isset property="jmods.macos"/><isset property="jdk.macos"/></or></condition>
    <condition property="jdk-jmods.linux"><and><isset property="jdk.linux"/><not><isset property="jmods.linux"/></not></and></condition>
    <condition property="jdk-jmods.windows"><and><isset property="jdk.windows"/><not><isset property="jmods.windows"/></not></and></condition>
    <condition property="jdk-jmods.macos"><and><isset property="jdk.macos"/><not><isset property="jmods.macos"/></not></and></condition>
    <condition property="platform.none"><not><or><isset property="platform.linux"/><isset property="platform.windows"/><isset property="platform.macos"/></or></not></condition>
    <fail if="platform.none" message="no jmods in ${jdk.archives} (jmods-linux.tar.gz, jmods-windows.zip, jmods-macos.tar.gz, Temurin's *jmods*linux*.tar.gz…, or a JDK up to 23's archive): run scripts/setup.sh (see doc/DEVKIT.md)"/>
  </target>

  <!-- jdeps and jlink: those of this machine's platform's archive, unpacked whole — jlink links only jmods of its own
       version, and the JDK running the build may be another (a system Java of another update) —, else the running JDK's -->
  <target name="tools" depends="detect">
    <condition property="host.linux"><and><equals arg1="${host}" arg2="linux"/><isset property="jdk.linux"/></and></condition>
    <condition property="host.windows"><and><equals arg1="${host}" arg2="windows"/><isset property="jdk.windows"/></and></condition>
    <condition property="host.macos"><and><equals arg1="${host}" arg2="macos"/><isset property="jdk.macos"/></and></condition>
    <condition property="jdk.tools" value="${target}/jdk-host" else="${java.home}">
      <or><isset property="host.linux"/><isset property="host.windows"/><isset property="host.macos"/></or>
    </condition>
  </target>
  <target name="tools-linux" depends="tools" if="host.linux">
    <delete dir="${target}/jdk-host"/>
    <untar dest="${target}/jdk-host" compression="gzip"><fileset dir="${jdk.archives}"><patternset refid="jdk.linux"/></fileset><cutdirsmapper dirs="1"/></untar>
    <chmod perm="755"><fileset dir="${target}/jdk-host" includes="bin/**, lib/jspawnhelper, lib/jexec"/></chmod>
  </target>
  <target name="tools-macos" depends="tools" if="host.macos">
    <delete dir="${target}/jdk-host"/>
    <untar dest="${target}/jdk-host" compression="gzip"><fileset dir="${jdk.archives}"><patternset refid="jdk.macos"/></fileset><patternset includes="*/Contents/Home/**"/><cutdirsmapper dirs="3"/></untar>
    <chmod perm="755"><fileset dir="${target}/jdk-host" includes="bin/**, lib/jspawnhelper, lib/jexec"/></chmod>
  </target>
  <target name="tools-windows" depends="tools" if="host.windows">
    <delete dir="${target}/jdk-host"/>
    <unzip dest="${target}/jdk-host"><fileset dir="${jdk.archives}"><patternset refid="jdk.windows"/></fileset><cutdirsmapper dirs="1"/></unzip>
  </target>

  <target name="modules" depends="tools, tools-linux, tools-macos, tools-windows">
    <echo message="jdeps and jlink: ${jdk.tools}"/>
    <exec executable="${jdk.tools}/bin/jdeps${exec.suffix}" outputproperty="modules.found" failonerror="true">
      <arg value="--ignore-missing-deps"/>
      <arg value="--print-module-deps"/>
      <arg value="--multi-release"/><arg value="${java.release}"/>
      <arg value="${jar}"/>
    </exec>
    <property name="modules" value="${modules.found},${modules.extra}"/>
    <echo message="the runtimes' modules: ${modules}"/>
  </target>

  <!-- each platform's jmods, from its jmods archive (one top folder of .jmod files), else from its JDK archive's jmods/ -->
  <target name="unpack-linux" depends="unpack-linux-jmods, unpack-linux-jdk"/>
  <target name="unpack-linux-jmods" if="jmods.linux">
    <delete dir="${jmods}/linux"/>
    <untar dest="${jmods}/linux" compression="gzip">
      <fileset dir="${jdk.archives}"><patternset refid="jmods.linux"/></fileset>
      <patternset includes="*/*.jmod"/>
      <cutdirsmapper dirs="1"/>
    </untar>
  </target>
  <target name="unpack-linux-jdk" if="jdk-jmods.linux">
    <delete dir="${jmods}/linux"/>
    <untar dest="${jmods}/linux" compression="gzip">
      <fileset dir="${jdk.archives}"><patternset refid="jdk.linux"/></fileset>
      <patternset includes="*/jmods/**"/>
      <cutdirsmapper dirs="2"/>
    </untar>
  </target>
  <target name="unpack-windows" depends="unpack-windows-jmods, unpack-windows-jdk"/>
  <target name="unpack-windows-jmods" if="jmods.windows">
    <delete dir="${jmods}/windows"/>
    <unzip dest="${jmods}/windows">
      <fileset dir="${jdk.archives}"><patternset refid="jmods.windows"/></fileset>
      <patternset includes="*/*.jmod"/>
      <cutdirsmapper dirs="1"/>
    </unzip>
  </target>
  <target name="unpack-windows-jdk" if="jdk-jmods.windows">
    <delete dir="${jmods}/windows"/>
    <unzip dest="${jmods}/windows">
      <fileset dir="${jdk.archives}"><patternset refid="jdk.windows"/></fileset>
      <patternset includes="*/jmods/**"/>
      <cutdirsmapper dirs="2"/>
    </unzip>
  </target>
  <target name="unpack-macos" depends="unpack-macos-jmods, unpack-macos-jdk"/>
  <target name="unpack-macos-jmods" if="jmods.macos">
    <delete dir="${jmods}/macos"/>
    <untar dest="${jmods}/macos" compression="gzip">
      <fileset dir="${jdk.archives}"><patternset refid="jmods.macos"/></fileset>
      <patternset includes="*/*.jmod"/>
      <cutdirsmapper dirs="1"/>
    </untar>
  </target>
  <target name="unpack-macos-jdk" if="jdk-jmods.macos">
    <delete dir="${jmods}/macos"/>
    <untar dest="${jmods}/macos" compression="gzip">
      <fileset dir="${jdk.archives}"><patternset refid="jdk.macos"/></fileset>
      <patternset includes="*/Contents/Home/jmods/**"/>
      <cutdirsmapper dirs="4"/>
    </untar>
  </target>
  <macrodef name="link">
    <attribute name="os"/>
    <sequential>
      <delete dir="${runtime}/@{os}"/>
      <echo message="jlink: the @{os} runtime"/>
      <exec executable="${jdk.tools}/bin/jlink${exec.suffix}" failonerror="true">
        <arg value="--module-path"/><arg value="${jmods}/@{os}"/>
        <arg value="--add-modules"/><arg value="${modules}"/>
        <arg value="--output"/><arg value="${runtime}/@{os}"/>
        <arg value="--strip-debug"/>
        <arg value="--no-man-pages"/>
        <arg value="--no-header-files"/>
        <arg value="--compress"/><arg value="zip-6"/>
      </exec>
    </sequential>
  </macrodef>
  <target name="link-linux" if="platform.linux"><link os="linux"/></target>
  <target name="link-windows" if="platform.windows"><link os="windows"/></target>
  <target name="link-macos" if="platform.macos"><link os="macos"/></target>

  <target name="runtimes" depends="modules, unpack-linux, unpack-windows, unpack-macos, link-linux, link-windows, link-macos"/>

  <!-- the launchers filled in with ${jtools.app.*}, and what is text, in each family's line endings -->
  <target name="texts">
    <delete dir="${work}"/>
    <copy todir="${work}/unix" encoding="UTF-8">
      <fileset dir="${launchers}" includes="app.sh, app.ini"/>
      <filterchain><expandproperties/><fixcrlf eol="lf"/></filterchain>
    </copy>
    <copy todir="${work}/windows" encoding="UTF-8">
      <fileset dir="${launchers}" includes="app.bat, app.ini"/>
      <filterchain><expandproperties/><fixcrlf eol="crlf"/></filterchain>
    </copy>
    <copy todir="${work}/unix" encoding="UTF-8">
      <fileset dir="${root}" includes="README.md, LICENSE, NOTICE"/>
      <filterchain><fixcrlf eol="lf"/></filterchain>
    </copy>
    <copy todir="${work}/windows" encoding="UTF-8">
      <fileset dir="${root}" includes="README.md, LICENSE, NOTICE"/>
      <filterchain><fixcrlf eol="crlf"/></filterchain>
    </copy>
  </target>

  <macrodef name="unix-dist">
    <attribute name="os"/>
    <sequential>
      <tar destfile="${release.dir}/${dist.name}-@{os}.tar.gz" compression="gzip" longfile="gnu">
        <tarfileset file="${jar}" fullpath="${dist.name}/${jtools.app.id}.jar" filemode="644"/>
        <tarfileset file="${work}/unix/app.sh" fullpath="${dist.name}/${jtools.app.id}.sh" filemode="755"/>
        <tarfileset file="${work}/unix/app.ini" fullpath="${dist.name}/${jtools.app.id}.ini" filemode="644"/>
        <tarfileset dir="${work}/unix" includes="README.md, LICENSE, NOTICE" prefix="${dist.name}" filemode="644"/>
        <tarfileset dir="${root}" includes="${include}" prefix="${dist.name}" filemode="644" dirmode="755"/>
        <tarfileset dir="${files}" prefix="${dist.name}" filemode="644" dirmode="755" erroronmissingdir="false"/>
        <tarfileset dir="${runtime}/@{os}" prefix="${dist.name}/jre" filemode="755" dirmode="755" includes="bin/**, lib/jspawnhelper, lib/jexec"/>
        <tarfileset dir="${runtime}/@{os}" prefix="${dist.name}/jre" filemode="644" dirmode="755" excludes="bin/**, lib/jspawnhelper, lib/jexec"/>
      </tar>
    </sequential>
  </macrodef>
  <target name="dist-linux" if="platform.linux"><unix-dist os="linux"/></target>
  <target name="dist-macos" if="platform.macos"><unix-dist os="macos"/></target>
  <target name="dist-windows" if="platform.windows">
    <zip destfile="${release.dir}/${dist.name}-windows.zip">
      <zipfileset file="${jar}" fullpath="${dist.name}/${jtools.app.id}.jar"/>
      <zipfileset file="${exe}" fullpath="${dist.name}/${jtools.app.name}.exe"/>
      <zipfileset file="${work}/windows/app.bat" fullpath="${dist.name}/${jtools.app.id}.bat"/>
      <zipfileset file="${work}/windows/app.ini" fullpath="${dist.name}/${jtools.app.id}.ini"/>
      <zipfileset dir="${work}/windows" includes="README.md, LICENSE, NOTICE" prefix="${dist.name}"/>
      <zipfileset dir="${root}" includes="${include}" prefix="${dist.name}"/>
      <zipfileset dir="${files}" prefix="${dist.name}" erroronmissingdir="false"/>
      <zipfileset dir="${runtime}/windows" prefix="${dist.name}/jre"/>
    </zip>
  </target>

  <target name="distributions" depends="runtimes, texts, dist-linux, dist-macos, dist-windows"/>
</project>
