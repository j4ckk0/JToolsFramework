# The files the devkit owns in every project: jtools new copies them into a new one, and scripts/jtools sync
# refreshes them in an existing one. A change to one is made here, in JToolsFramework's devkit/, never in
# its own copy (each says so in its header). One path per line, relative to the devkit and to the project.
scripts/externals.sh
scripts/setup.sh
scripts/build.sh
scripts/ci.sh
scripts/run.sh
scripts/stop.sh
scripts/package.sh
scripts/externals.bat
scripts/setup.bat
scripts/build.bat
scripts/ci.bat
scripts/run.bat
scripts/stop.bat
scripts/package.bat
.githooks/pre-push
.gitattributes
